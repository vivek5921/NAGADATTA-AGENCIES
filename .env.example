# Environment Configuration for Nagadatta Agencies

# Server Port (Local Dev)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=production

# Database Connection (Persistent PostgreSQL on Neon.tech / Supabase.com)
DATABASE_URL=postgresql://user:password@ep-cool-name-12345.ap-southeast-1.aws.neon.tech/nagadatta_db?sslmode=require

# Security & Admin Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_nagadatta_2026

# Cloudinary Persistent Image Storage Credentials
CLOUDINARY_CLOUD_NAME=nagadatta_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Frontend API URL override (only if frontend and backend are deployed on separate domains)
# VITE_API_URL=https://nagadattaagencies.vercel.app/api
