# Environment Configuration for Nagadatta Agencies

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database Connection (Leave empty to use local zero-config SQLite database at server/db/nagadatta.sqlite)
# For PostgreSQL deployment on Railway/Render/Neon/Supabase:
DATABASE_URL=postgresql://postgres:password@localhost:5432/nagadatta_db

# Security & Admin Authentication Secret
JWT_SECRET=nagadatta_secret_key_karimnagar_2026

# Cloudinary Credentials (Optional for cloud image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
